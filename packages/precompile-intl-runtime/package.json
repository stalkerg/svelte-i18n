{
  "name": "@stalkerg/precompile-intl-runtime",
  "version": "1.0.0-alpha.2",
  "description": "Runtime helpers to be used in translations precompiled by babel-plugin-precompile-intl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stalkerg/svelte-icu.git",
    "directory": "packages/precompile-intl-runtime"
  },
  "author": {
    "name": "Miguel Camba",
    "email": "miguel.camba@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "module": "dist/modules/index.js",
  "types": "dist/modules/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/modules/index.js",
      "types": "./dist/modules/index.d.ts",
      "default": "./dist/modules/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "Changelog.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "keywords": [
    "helpers",
    "Intl",
    "precompile",
    "runtime",
    "i18n"
  ]
}
