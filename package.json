{
  "name": "@stalkerg/svelte-icu-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.16.0",
  "overrides": {
    "cookie": "0.7.2"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && vitest run",
    "test:e2e:build": "npm run build && node scripts/build-e2e-fixture.mjs && svelte-check --workspace packages/svelte-intl-precompile/tests/fixtures/sveltekit-lazy --tsconfig ./tsconfig.json",
    "test:e2e": "npm run test:e2e:build && playwright test",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run test"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/convert-source-map": "^2.0.3",
    "@types/node": "^26.0.0",
    "prettier": "^3.9.6",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
